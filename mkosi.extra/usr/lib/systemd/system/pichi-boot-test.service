#
# TEMPORARY (test only): proves the full pichi boot chain and powers off so
# `pichi run` returns. Fires once the carapace's own systemd is fully up, then
# emits a console marker and shuts the VM down cleanly. Remove once real
# workloads run in the carapace.
[Unit]
Description=Prove carapace boot, then power off (pichi TEST ONLY)
After=multi-user.target

[Service]
Type=oneshot
# Marker goes to /dev/kmsg so it reaches the console via the kernel ring
# buffer (the path that survives to whichever console the operator wired).
ExecStart=/usr/bin/sh -c 'echo PICHI-CARAPACE-BOOT-OK > /dev/kmsg; systemctl poweroff --no-block'

[Install]
WantedBy=multi-user.target
