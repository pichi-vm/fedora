#!/usr/bin/env python3
# SPDX-FileCopyrightText: Advanced Micro Devices, Inc.
# SPDX-License-Identifier: Apache-2.0
#
# Runs against the built rootfs tree before mkosi.repart/ packs it into ext4.
# Three jobs (mkosi runs this privileged in its own user namespace):
#
#   1. copy the kernel image + config out to $OUTPUTDIR for the PMI (arma reads
#      them via --kernel / --config); record the kver for build.sh;
#   2. export the modules the initramfs needs — the carapace-boot pivot set
#      (virtio transport + disk + console, the dm-snapshot/verity stack, ext4)
#      filtered to what is a *module* (not builtin) for THIS kernel, plus their
#      dependency closure — into $OUTPUTDIR/initrd-mods/. build.sh cpios these
#      alongside the static carapace `init`. For a stock Fedora kernel almost
#      all of the set is builtin, so this is typically just dm-verity (+deps);
#      the set is distro-agnostic — a kernel with modular virtio/ext4 ships more;
#   3. strip /boot and the in-tree vmlinuz/System.map — boot payload is the
#      PMI's domain; the carapace keeps only its .ko module tree.

import glob
import os
import shutil

buildroot = os.environ["BUILDROOT"]
outdir = os.environ["OUTPUTDIR"]
kd = glob.glob(f"{buildroot}/usr/lib/modules/*/")[0].rstrip("/")
kver = os.path.basename(kd)

# ---- 1. kernel image + config + kver -------------------------------------
shutil.copy2(f"{kd}/vmlinuz", f"{outdir}/vmlinuz")
shutil.copy2(f"{kd}/config", f"{outdir}/kernel.config")
with open(f"{outdir}/kver", "w") as f:
    f.write(kver + "\n")

# ---- 2. export the initramfs module set (pivot set + dep closure) --------
# Only what carapace-init needs to reach and mount the root carapace: the
# virtio transport + disk + console, the dm stack, and ext4. Members the kernel
# builds in are absent from modules.dep and skipped. No networking — nothing
# before switch_root uses it, and virtio_net would drag in net_failover/failover
# and cost failed-then-retried module loads; the running OS still loads
# virtio_net from its own (unstripped) rootfs module tree.
PIVOT = [
    "virtio_pci", "virtio_blk", "virtio_console",
    "dm-mod", "dm-snapshot", "dm-verity", "ext4",
]

deps, byname = {}, {}
with open(f"{kd}/modules.dep") as f:
    for line in f:
        mod, _, rest = line.partition(":")
        mod = mod.strip()
        deps[mod] = rest.split()
        byname[os.path.basename(mod).split(".ko")[0]] = mod

keep, stack = set(), [byname[n] for n in PIVOT if n in byname]
while stack:
    m = stack.pop()
    if m in keep:
        continue
    keep.add(m)
    stack.extend(deps.get(m, []))

modsroot = f"{outdir}/initrd-mods/usr/lib/modules/{kver}"
os.makedirs(modsroot, exist_ok=True)
for rel in sorted(keep):
    src = f"{kd}/{rel}"
    dst = f"{modsroot}/{rel}"
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copy2(src, dst)
print(f">>> initrd module set: {len(keep)} .ko exported (from {len(PIVOT)} pivot roots)")

# ---- 3. strip boot payload from the carapace rootfs ----------------------
shutil.rmtree(f"{buildroot}/boot", ignore_errors=True)
for f in (f"{kd}/vmlinuz", f"{kd}/System.map"):
    try:
        os.remove(f)
    except FileNotFoundError:
        pass
